{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "interview-frontend": {
      "root": ".",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "flask",
      "entrypoint": "run.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "interview-frontend"
      }
    }
  ]
}
